# "Fehler melden" fuer routerwahl.ffnef.de und routersoftware.ffnef.de.
# Einrichtung siehe dienst/README.md.
[Unit]
Description=Fehlermeldungen zu Geraetedaten annehmen und mailen
After=network.target

[Service]
ExecStart=/usr/bin/python3 -I /var/www/selector-config/dienst/fehlermeldung.py
Environment=FEHLERMELDUNG_ADRESSE=127.0.0.1:8471
User=nobody
Group=nogroup
# nullmailer-queue ist setuid "mail" und schreibt nach /var/spool/nullmailer:
# deshalb kein NoNewPrivileges und kein ProtectSystem=strict.
ProtectSystem=full
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
