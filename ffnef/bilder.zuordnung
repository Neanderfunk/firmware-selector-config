# Geraete, deren Bildname im Downloader anders lautet als in
# freifunk/device-pictures. Je Zeile: <Name laut devices.js> <Name im Bildrepo>
#
# deploy.sh legt dafuer einen Symlink an. So bleibt das Bildrepo unberuehrt
# und nachziehbar, und wir kopieren keine einzige Datei.
#
# Zwei Faelle sind reine Schreibweise (wir "gl.inet-", das Repo "gl-inet-"),
# drei sind Varianten-Suffixe fuer dasselbe Geraet.

d-link-dap-1330-rev        d-link-dap-1330
gl.inet-gl-ar300m-nor      gl-inet-gl-ar300m-nor
gl.inet-gl-mt1300          gl-inet-gl-mt1300
ubiquiti-rocket-m5-ti      ubiquiti-rocket-m5
zbt-wg3526-16m             zbt-wg3526

# --- 06.10.2026, zweiter Durchgang -------------------------------------
# Die Karte normalisiert den Modellnamen MIT Versionssuffix ("Cudy WR3000 v1"
# -> cudy-wr3000-v1), unsere devices.js kennt oft nur den Grundnamen. Deshalb
# fanden diese Geraete ihr Bild nicht, obwohl eines da ist.
#
# Exakt dasselbe Geraet, nur andere Schreibweise:
gl.inet-gl-e750            gl-inet-gl-e750
#
# Grundname trifft auf genau eine Version im Bildrepo:
cudy-wr3000                cudy-wr3000-v1
gl-inet-6408a              gl-inet-6408a-v1
tp-link-archer-c2          tp-link-archer-c2-v1
tp-link-archer-c20         tp-link-archer-c20-v1
tp-link-archer-c5          tp-link-archer-c5-v1
tp-link-archer-c59         tp-link-archer-c59-v1
tp-link-re200              tp-link-re200-v1
tp-link-tl-mr3420          tp-link-tl-mr3420-v1
tp-link-tl-wdr3500         tp-link-tl-wdr3500-v1
tp-link-tl-wdr3600         tp-link-tl-wdr3600-v1
tp-link-tl-wdr4300         tp-link-tl-wdr4300-v1
tp-link-tl-wdr4900         tp-link-tl-wdr4900-v1
tp-link-wbs510             tp-link-wbs510-v1
#
# Naeherung: unser Eintrag ist versionslos, im Bildrepo gibt es nur eine
# spaetere Version. Aeusserlich unterscheiden sich die Versionen kaum, das
# Bild ist also besser als keines - aber es ist nicht streng dasselbe Geraet.
tp-link-archer-c7          tp-link-archer-c7-v2
tp-link-tl-wa801nd         tp-link-tl-wa801nd-v2

# --- 06.10.2026, dritter Durchgang ------------------------------------
# Aus der Fototabelle der Mapserver-Session (router-werkstatt
# docs/geraetefotos.md): Geraete, die im Feld stehen, bei uns kein Bild
# hatten, im Bildrepo aber unter anderem Namen eines haben. Nichts davon
# muss fotografiert werden.
#
# Dasselbe Geraet, nur andere Schreibweise oder anderer Modellname:
gl-ar150                   gl.inet-gl-ar150
tp-link-cpe210-220         tp-link-cpe210
ubiquiti-nano-m-xw         ubiquiti-nanostation-m-xw
ubiquiti-nanostation-loco-m2-xw  ubiquiti-loco-m-xw
netgear-wndr3800ch         netgear-wndr3800
ubiquiti-unifi-outdoor     ubiquiti-unifiap-outdoor
#
# Das Bildrepo kennt genau eine Version, unser Eintrag ist versionslos:
tp-link-archer-a7          tp-link-archer-a7-v5
tp-link-tl-wa850re         tp-link-tl-wa850re-v1
tp-link-tl-wa860re         tp-link-tl-wa860re-v1
tp-link-tl-wr2543n-nd      tp-link-tl-wr2543n-nd-v1
xiaomi-mi-router-4a-gigabit-edition-v2  xiaomi-mi-router-4a-gigabit-edition
#
# Mehrere Versionen im Bildrepo, unser Eintrag ist versionslos. Genommen ist
# die Version, die bei uns wirklich im Feld steht, gezaehlt auf der Karte am
# 06.10.2026. Keine Schaetzung:
#   CPE510     1x v1
#   WR740N/ND  1x v4
#   WR741N/ND  3x v1, 1x v4  -> v1
#   WR941N/ND  4x v6
#   WA901N/ND  1x v3
tp-link-cpe510             tp-link-cpe510-v1
tp-link-tl-wr740n-nd       tp-link-tl-wr740n-nd-v4
tp-link-tl-wr741n-nd       tp-link-tl-wr741n-nd-v1
tp-link-tl-wr941nd         tp-link-tl-wr941n-nd-v6
tp-link-tl-wa901nd         tp-link-tl-wa901n-nd-v3
#
# Sonderfall: das Bildrepo haengt dem "Outdoor+" einen Bindestrich an,
# wo das Pluszeichen weggefallen ist. Die Datei heisst wirklich so.
ubiquiti-unifi-outdoor-plus  ubiquiti-unifiap-outdoor-
